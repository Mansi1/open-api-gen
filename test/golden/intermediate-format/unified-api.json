    {
      "name": "OffsetService",
      "property": "offset",
      "folder": "offset-service",
      "description": "Offset management service",
      "operations": [
        {
          "name": "createOffset",
          "operationId": "createOffset",
          "method": "POST",
          "path": "/v1/offset",
          "summary": "Creates a offset for scheduled processing",
          "parameters": {
            "header": {
              "declaration": "CreateOffsetHeaderParameter",
              "required": false,
              "parameters": [
                {
                  "name": "X-Sdk-Version",
                  "required": false,
                  "type": {
                    "kind": "string",
                    "constraints": {}
                  },
                  "style": "simple",
                  "explode": false,
                  "description": "SDK version header"
                }
              ]
            }
          },
