{
  "name": "open-api-gen",
  "version": "0.1.0",
  "description": "Generates TypeScript API clients from OpenAPI 3.0, 3.1 and 3.2 documents",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "license": "MIT",
  "author": "mansi <mad.mansi90@gmail.com>",
  "bin": {
    "open-api-gen": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pkgroll --clean-dist"
  },
  "dependencies": {
    "@hyperjump/json-schema": "1.18.0",
    "jsonpath-rfc9535": "1.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxlint": "1.90.0",
    "pkgroll": "2.29.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "6.0.3"
  }
}
